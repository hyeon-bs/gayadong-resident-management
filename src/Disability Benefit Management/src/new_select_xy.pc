void DB_connect()
{
   strcpy((char *)uid.arr,"b20163374@//sedb.deu.ac.kr:1521/orcl");
   uid.len = (short) strlen((char *)uid.arr);
   strcpy((char *)pwd.arr,"20163374");
   pwd.len = (short) strlen((char *)pwd.arr);

   EXEC SQL CONNECT :uid IDENTIFIED BY :pwd;

	// connection이 실패했을경우의 처리부분

	if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405){
		printf("\7Cconnect error: %s", sqlca.sqlerrm.sqlerrmc);
		getch();
		exit(-1);
	}

    printf("Oracle Connect SUCCESS by %s\n", uid.arr);
}

#define PAGE_NUM 20
void Get_tuple()
{
/* --------------------------------------------------------------------------
   Retrieve the current maximum employee number
-------------------------------------------------------------------------- */
EXEC SQL BEGIN DECLARE SECTION;
   varchar name[100];
   varchar social[200];
   varchar grade[500];
   varchar benefits[500];

   char dynstmt[1000];
EXEC SQL END DECLARE SECTION;

   int x, y, count=0, i ;


   /* Register sql_error() as the error handler. */
   EXEC SQL WHENEVER SQLERROR DO sql_error("\7ORACLE ERROR:\n");

   /* 사용자 입력 */
   clrscr();

   print_screen("scr_select.txt");

   /* 실행시킬 SQL 문장*/
   sprintf(dynstmt, "SELECT  D_NAME, D_SOCIAL_NUM, D_GRADE, D_BENEFITS FROM DISORDER");
   //printf("dynstmt:%s\n", dynstmt);

   EXEC SQL PREPARE S3 FROM :dynstmt ;

   /* cursor 선언 */
   EXEC SQL DECLARE c_cursor CURSOR FOR S3 ;

   /* cursor open */
   EXEC SQL OPEN c_cursor ;

   EXEC SQL WHENEVER NOT FOUND DO break;


   x = 2;
   y = 10;

   for (;;)
    {
        EXEC SQL FETCH c_cursor INTO :name, :social, :grade, :benefits;
	name.arr[name.len] = '\0' ;
	social.arr[social.len] = '\0';
	grade.arr[grade.len] = '\0';
        benefits.arr[benefits.len] = '\0';

	gotoxy(x,y);
	printf("     %-10s     |     %-20s     |     %-20s     |     %-10s     ", name.arr, social.arr, grade.arr, benefits.arr);
	y++;
	count++;
	if( count == PAGE_NUM){
	   printf("\n                                  hit any key\n");
	   count = 0;
	   getch();

	   gotoxy(0,9); //이전 화면 부분 클리어
           for(i= 0; i < PAGE_NUM; i++){
		printf("                                                          \n");
	   }

	   y = 10 ;
	}

    }
	printf("                              (END)\n");

    /* Close the cursor. */
   EXEC SQL CLOSE c_cursor;

   EXEC SQL COMMIT ;
}

void Update_tuple() //이름으로 대상자를 찾아 이달의 복지 혜택을 갱신
{
EXEC SQL BEGIN DECLARE SECTION;
   char dynstmt2[1000];
EXEC SQL END DECLARE SECTION;
   char no_temp2[100];
   char no_benefit[500];

   EXEC SQL WHENEVER SQLERROR DO sql_error("\7ORACLE ERROR:\n");

   gotoxy(14,6);
   printf("이름 :");
   gets(no_temp2);

   gotoxy(14,8);
   printf("이달의 혜택 :");
   gets(no_benefit);

   sprintf(dynstmt2, "update disorder set d_benefits = '%s' where d_name like '%%%s%%' and rownum = 1", no_benefit, no_temp2);

   EXEC SQL EXECUTE IMMEDIATE :dynstmt2;
   EXEC SQL COMMIT WORK;

   printf("업데이트완료");
}



void print_screen(char fname[])
{
	FILE *fp;
	char line[100];

	if ( (fp = fopen(fname,"r"))  == NULL ){
		printf("file open error\n");
		getch();
		exit(-1);
	}
	while(1)
	{
		if( fgets(line, 99, fp) == NULL){
		     break;
		}
		printf("%s", line);
	}

	fclose(fp);
}

/* --------------------------------------------------------------------------
int sql_error()

   errrpt prints the ORACLE error msg and number.
-------------------------------------------------------------------------- */
void sql_error(char *msg)
{
    char err_msg[128];
    size_t buf_len, msg_len;

    EXEC SQL WHENEVER SQLERROR CONTINUE;

    printf("\n%s\n", msg);
    buf_len = sizeof (err_msg);
    sqlglm(err_msg, &buf_len, &msg_len);
    printf("%.*s\n", msg_len, err_msg);

    getch();
    EXEC SQL ROLLBACK WORK;
    //exit(EXIT_FAILURE);
}
/*---------------  화면 커서 제어 함수 --------------------*/
#define STD_HANDLE GetStdHandle(STD_OUTPUT_HANDLE)

void gotoxy(int x, int y)
{
    COORD Cur= {(SHORT)x, (SHORT) y};

    SetConsoleCursorPosition(STD_HANDLE, Cur);
}

void getxy(int *x, int *y)
{
    CONSOLE_SCREEN_BUFFER_INFO Buf ;

    GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), &Buf);
    *x = (int)Buf.dwCursorPosition.X ;
    *y = (int)Buf.dwCursorPosition.Y ;

}

void clrscr(void)
{
    COORD Cur= {0, 0};
    unsigned long dwLen;

    FillConsoleOutputCharacter(STD_HANDLE, ' ', 80*25, Cur, &dwLen);
}

